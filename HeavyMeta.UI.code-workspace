{
  "folders": [
    {
      "name": "HeavyMeta UI",
      "path": "."
    }
  ],
  "settings": {
    "files.exclude": {
      "**/node_modules": true,
      "**/dist": true
    }
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "UI: dev",
        "type": "shell",
        "command": "npm run dev",
        "isBackground": true,
        "problemMatcher": []
      },
      {
        "label": "UI: build",
        "type": "shell",
        "command": "npm run build",
        "group": "build",
        "problemMatcher": []
      }
    ]
  }
}
